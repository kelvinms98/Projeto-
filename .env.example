# Assistente de pesquisa (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Banco local do assistente de pesquisa (Python)
DB_BACKEND=sqlite
DB_SQLITE_PATH=data/agent.db

# Se usar XAMPP MySQL:
# DB_BACKEND=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=agente

# Loja NEXUS (servidor Node.js + SQLite)
NEXUS_API_URL=http://127.0.0.1:8081
NEXUS_WEB_HOST=0.0.0.0
NEXUS_WEB_PORT=8081
NEXUS_SQLITE_PATH=data/nexus-store.sqlite3
NEXUS_SECRET_KEY=gere-uma-chave-aleatoria-longa-e-privada

# E-mail de confirmação de pedidos via SMTP (Gmail: use uma senha de app)
NEXUS_SMTP_HOST=smtp.gmail.com
NEXUS_SMTP_PORT=465
NEXUS_SMTP_SECURE=true
NEXUS_SMTP_USER=nexusstorestred@gmail.com
NEXUS_SMTP_PASSWORD=
NEXUS_EMAIL_FROM=nexusstorestred@gmail.com

# Frete fixo para entregas: frete base + taxa de serviço
NEXUS_SHIPPING_BASE_BRL=8.00
NEXUS_SHIPPING_SERVICE_BRL=3.50

# Apenas para a importação inicial do banco MySQL antigo:
# LEGACY_DB_HOST=127.0.0.1
# LEGACY_DB_PORT=3306
# LEGACY_DB_USER=root
# LEGACY_DB_PASSWORD=
# LEGACY_DB_NAME=NEXUS

# Supabase
SUPABASE_URL=https://khimlcgwdhmuymqolzpu.supabase.co
SUPABASE_KEY=

# Postgres connection string (use apenas no backend)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.khimlcgwdhmuymqolzpu.supabase.co:5432/postgres
